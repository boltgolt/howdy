[complete, functional code content - NOT documentation]
pkgname=howdy
pkgver=2.6.1
pkgrel=1
pkgdesc="Windows Hello™ style facial authentication for Linux"
arch=('x86_64')
url="https://github.com/boltgolt/howdy"
license=('GPL3')
depends=('python3' 'python3-pip' 'python3-setuptools' 'python3-wheel' 'opencv' 'dlib' 'cmake' 'make' 'pam' 'libpam0g' 'inih')
makedepends=('meson' 'ninja')
optdepends=('pamtester: for PAM-based monitoring scripts')
source=("https://github.com/boltgolt/howdy/archive/v${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd howdy-${pkgver}
    
    # Apply patches if needed
    # patch -p1 -i ../001-add-scripting-support.patch
}

build() {
    cd howdy-${pkgver}
    
    # Build with meson
    meson setup build --buildtype=release
    meson compile -C build
}

check() {
    cd howdy-${pkgver}
    
    # Run basic tests
    python3 -c "import sys; sys.path.insert(0, 'src'); from cli.check import help; help()" || true
}

package() {
    cd howdy-${pkgver}
    
    # Install binaries
    install -Dm 755 "src/bin/howdy" "$pkgdir/usr/bin/howdy"
    
    # Install CLI commands
    install -d "$pkgdir/usr/share/howdy/cli"
    cp -r src/cli/* "$pkgdir/usr/share/howdy/cli/"
    cp src/cli.py "$pkgdir/usr/share/howdy/"
    
    # Install man page
    install -Dm 644 "manpages/howdy.1" "$pkgdir/usr/share/man/man1/howdy.1"
    
    # Install configuration and examples
    install -d "$pkgdir/etc/howdy"
    install -Dm 644 "config.ini" "$pkgdir/etc/howdy/howdy.ini"
    install -Dm 644 "README.md" "$pkgdir/usr/share/doc/howdy/README.md"
    install -Dm 644 "examples/scripting-example.md" "$pkgdir/usr/share/doc/howdy/scripting-example.md"
    
    # Install monitoring scripts
    install -d "$pkgdir/usr/share/howdy/examples"
    install -Dm 755 "examples/howdy-monitor.sh" "$pkgdir/usr/share/howdy/examples/howdy-monitor.sh"
    install -Dm 755 "examples/pamtester-monitor.sh" "$pkgdir/usr/share/howdy/examples/pamtester-monitor.sh"
    
    # Symlink howdy to the main script
    ln -s ../share/howdy/cli.py "$pkgdir/usr/bin/howdy"
    
    # Install systemd service file
    install -d "$pkgdir/usr/lib/systemd/system"
    install -Dm 644 <EOF "$pkgdir/usr/lib/systemd/system/howdy-monitor.service"
[Unit]
Description=Howdy Periodic User Verification
Documentation=man:howdy(1)
After=multi-user.target

[Service]
Type=simple
User=@PAM_USER@
Environment=HOME=@PAM_USER_HOME@
Environment=CHECK_INTERVAL=300
Environment=TIMEOUT=10
Environment=MAX_FAILURES=3
Environment=ENABLE_LOCKING=true
ExecStart=/usr/share/howdy/examples/howdy-monitor.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF
}

