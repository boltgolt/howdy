#!/usr/bin/make -f
DH_VERBOSE = 1

DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/default.mk

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	# Install to the same locations as previous Howdy packages
	dh_auto_configure -- \
		-Dinih:with_INIReader=true \
		-Dpython_path=/usr/bin/python3 \
		-Dconfig_dir=/etc/howdy \
		-Ddlib_data_dir=/etc/howdy/dlib-data \
		-Dpy_sources_dir=/lib/security \
		-Dpam_dir=/lib/security/howdy \
		-Dinstall_pam_config=true

override_dh_auto_clean:
	dh_auto_clean
	# Make sure subprojects get pulled locally
	meson subprojects download --sourcedir .
