[complete, functional code content - NOT documentation]
#!/bin/bash

# Install binaries
mkdir -p debian/howdy/usr/bin
install -m 755 src/bin/howdy debian/howdy/usr/bin/howdy

# Install CLI commands
mkdir -p debian/howdy/usr/share/howdy/cli
cp -r src/cli/* debian/howdy/usr/share/howdy/cli/
cp src/cli.py debian/howdy/usr/share/howdy/

# Install man page
mkdir -p debian/howdy/usr/share/man/man1
install -m 644 manpages/howdy.1 debian/howdy/usr/share/man/man1/

# Install configuration and examples
mkdir -p debian/howdy/etc/howdy
mkdir -p debian/howdy/usr/share/doc/howdy
install -m 644 config.ini debian/howdy/etc/howdy/howdy.ini
install -m 644 README.md debian/howdy/usr/share/doc/howdy/
install -m 644 examples/scripting-example.md debian/howdy/usr/share/doc/howdy/

# Install monitoring scripts
mkdir -p debian/howdy/usr/share/howdy/examples
install -m 755 examples/howdy-monitor.sh debian/howdy/usr/share/howdy/examples/
install -m 755 examples/pamtester-monitor.sh debian/howdy/usr/share/howdy/examples/

# Symlink howdy to the main script
ln -s ../share/howdy/cli.py debian/howdy/usr/bin/howdy