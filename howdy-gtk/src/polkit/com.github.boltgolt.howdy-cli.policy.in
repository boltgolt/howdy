<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
  "https://specifications.freedesktop.org/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>boltgolt</vendor>
  <vendor_url>https://github.com/boltgolt/howdy</vendor_url>
  <icon_name>howdy-gtk</icon_name>
  <action id="com.github.boltgolt.howdy.cli">
    <description>Manage Howdy face authentication models and settings</description>
    <message>Authentication is required to change Howdy's face models and settings</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@howdy_cli_path@</annotate>
  </action>
</policyconfig>
